    <string name="log_enable">Guardar registro de diagnóstico</string>
    <string name="log_description">Registra la actividad de conexión, suscripciones, servicio, Tasker y pantallas para poder analizar un problema solo con el registro. Las contraseñas nunca se registran; los temas y el inicio de los mensajes sí. Revisa el registro antes de compartirlo públicamente.</string>
